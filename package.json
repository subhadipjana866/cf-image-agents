{
  "name": "image-chat-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "agents": "docker build -t kognie-agents agents_service && docker run --rm -p 8090:8080 --env-file .dev.vars kognie-agents",
    "agents:local": "cd agents_service && uvicorn service:app --port 8090"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/react": "^4.0.186",
    "@cloudflare/ai-chat": "^0.12.3",
    "@cloudflare/containers": "^0.3.7",
    "agents": "^0.34.0",
    "ai": "^7.0.181",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}